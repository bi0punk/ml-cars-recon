# ============================================================
# Credenciales de cámara RTSP/ISAPI
# ============================================================
RTSP_USER=admin
RTSP_PASSWORD=cambia_esta_contraseña
RTSP_HOST=192.168.1.64
RTSP_PORT=554
RTSP_CHANNEL=101

# Canal para snapshot ISAPI (main stream, alta calidad)
SNAPSHOT_CHANNEL=101

# ============================================================
# YOLO
# ============================================================
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.45
CONFIDENCE_THRESHOLD=0.35

# ============================================================
# Web App (web_app/app.py)
# ============================================================
# URL RTSP completa para el stream de la web app
RTSP_URL=rtsp://admin:pass@192.168.1.64:554/ISAPI/Streaming/channels/102
# Directorio de capturas servido por la web
CAPTURE_DIR=isapi_snaps
# Cantidad de imágenes recientes a listar
LATEST_LIMIT=3

# Modelo e inferencia
MODEL_PATH=yolov8n.pt
INFER_EVERY_N=2
IMG_SIZE=640

# ROI (porcentajes relativos al frame)
ROI_W_PCT=0.60
ROI_H_PCT=0.50
ROI_CY_PCT=0.45

# ISAPI (snapshots cuando el vehículo está dentro del ROI)
ISAPI_HOST=192.168.1.64
ISAPI_USER=admin
ISAPI_PASSWORD=
SNAPSHOT_COOLDOWN=1.0

# Host/puerto del servidor Flask
HOST=127.0.0.1
PORT=5000

# Token opcional para las rutas /api y /video_feed (X-API-Token)
API_TOKEN=generate_a_random_token_here